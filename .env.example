# PostgreSQL connection string used at runtime.
# On Supabase use the transaction pooler (port 6543) so serverless functions
# don't exhaust connections: ...pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://infinit:password@localhost:5432/infinit_calc?schema=public"

# Unpooled connection used only for migrations (pgbouncer can't run DDL).
# On Supabase this is the direct/session connection on port 5432.
DIRECT_URL="postgresql://infinit:password@localhost:5432/infinit_calc?schema=public"

# Session signing key — random, at least 32 characters (openssl rand -base64 48)
AUTH_SECRET=""

# Absolute base URL used in notification emails
APP_BASE_URL="http://localhost:3000"

# Build stamp printed on every exported PDF. Set to the deployed commit SHA.
APP_BUILD=""

# Bootstrap administrator, used by `npm run db:seed` only
SEED_ADMIN_EMAIL="admin@infinit.us"
SEED_ADMIN_NAME="InfinIT Administrator"
SEED_ADMIN_PASSWORD=""

# Optional SMTP. Without SMTP_HOST the app falls back to the in-app review queue.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="infinIT Calculator <no-reply@infinit.us>"
